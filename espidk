-- ============ PRECISION ESP LIBRARY ============
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local camera = workspace.CurrentCamera
local player = Players.LocalPlayer

local espDrawings = {}

espSettings = {
    SkeletonEnabled = false,
    TracerTargetEnabled = false,
    HealthBarEnabled = false,
    NamesEnabled = true,
    MaxDistance = 500,
    RefreshRate = 1/60,
    SkeletonColor = Color3.fromRGB(255, 255, 255),
    SkeletonThickness = 1.5,
    SkeletonTransparency = 1
}

local function createESP(plr)
    if plr == player then return end
    
    local skeleton = {}
    local boneNames = {
        "Head", "Neck", "UpperSpine", "LowerSpine",
        "LeftShoulder", "LeftUpperArm", "LeftLowerArm", "LeftHand",
        "RightShoulder", "RightUpperArm", "RightLowerArm", "RightHand",
        "LeftHip", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
        "RightHip", "RightUpperLeg", "RightLowerLeg", "RightFoot"
    }
    
    for _, name in ipairs(boneNames) do
        skeleton[name] = Drawing.new("Line")
        skeleton[name].Visible = false
        skeleton[name].Color = espSettings.SkeletonColor
        skeleton[name].Thickness = espSettings.SkeletonThickness
        skeleton[name].Transparency = espSettings.SkeletonTransparency
    end
    
    local tracer = Drawing.new("Line")
    tracer.Visible = false
    tracer.Color = Color3.fromRGB(255, 182, 255)
    tracer.Thickness = 1.5
    tracer.Transparency = 1
    
    local healthBar = {
        Outline = Drawing.new("Square"),
        Fill = Drawing.new("Square")
    }
    
    healthBar.Outline.Visible = false
    healthBar.Outline.Color = Color3.fromRGB(0, 0, 0)
    healthBar.Outline.Filled = true
    
    healthBar.Fill.Visible = false
    healthBar.Fill.Color = Color3.fromRGB(0, 255, 0)
    healthBar.Fill.Filled = true
    
    local nameTag = Drawing.new("Text")
    nameTag.Visible = false
    nameTag.Center = true
    nameTag.Size = 14
    nameTag.Color = Color3.fromRGB(255, 255, 255)
    nameTag.Outline = true
    
    espDrawings[plr] = {
        Skeleton = skeleton,
        Tracer = tracer,
        HealthBar = healthBar,
        NameTag = nameTag
    }
end

local function removeESP(plr)
    local esp = espDrawings[plr]
    if esp then
        for _, line in pairs(esp.Skeleton) do
            line:Remove()
        end
        esp.Tracer:Remove()
        esp.HealthBar.Outline:Remove()
        esp.HealthBar.Fill:Remove()
        esp.NameTag:Remove()
        espDrawings[plr] = nil
    end
end

local function hideESP(plr)
    local esp = espDrawings[plr]
    if esp then
        for _, line in pairs(esp.Skeleton) do
            line.Visible = false
        end
        esp.Tracer.Visible = false
        esp.HealthBar.Outline.Visible = false
        esp.HealthBar.Fill.Visible = false
        esp.NameTag.Visible = false
    end
end

local function getBonePositions(char)
    local bones = {
        Head = char:FindFirstChild("Head"),
        UpperTorso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"),
        LowerTorso = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso"),
        LeftUpperArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm"),
        LeftLowerArm = char:FindFirstChild("LeftLowerArm") or char:FindFirstChild("Left Arm"),
        LeftHand = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm"),
        RightUpperArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm"),
        RightLowerArm = char:FindFirstChild("RightLowerArm") or char:FindFirstChild("Right Arm"),
        RightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"),
        LeftUpperLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg"),
        LeftLowerLeg = char:FindFirstChild("LeftLowerLeg") or char:FindFirstChild("Left Leg"),
        LeftFoot = char:FindFirstChild("LeftFoot") or char:FindFirstChild("Left Leg"),
        RightUpperLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg"),
        RightLowerLeg = char:FindFirstChild("RightLowerLeg") or char:FindFirstChild("Right Leg"),
        RightFoot = char:FindFirstChild("RightFoot") or char:FindFirstChild("Right Leg")
    }
    return bones
end

local function drawBone(line, partA, partB)
    if not partA or not partB then
        line.Visible = false
        return
    end
    
    local posA, visibleA = camera:WorldToViewportPoint(partA.Position)
    local posB, visibleB = camera:WorldToViewportPoint(partB.Position)
    
    if not visibleA or not visibleB then
        line.Visible = false
        return
    end
    
    line.From = Vector2.new(posA.X, posA.Y)
    line.To = Vector2.new(posB.X, posB.Y)
    line.Visible = true
end

local function updateESP(plr)
    local esp = espDrawings[plr]
    if not esp then return end
    
    local char = plr.Character
    if not char then
        hideESP(plr)
        return
    end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then
        hideESP(plr)
        return
    end
    
    local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)
    local distance = (hrp.Position - camera.CFrame.Position).Magnitude
    
    if not onScreen or distance > espSettings.MaxDistance then
        hideESP(plr)
        return
    end
    
    local teamColor = Color3.fromRGB(255, 0, 0)
    if plr.TeamColor then teamColor = plr.TeamColor.Color
    elseif plr.Team and plr.Team.TeamColor then teamColor = plr.Team.TeamColor.Color end
    
    if espSettings.SkeletonEnabled then
        local bones = getBonePositions(char)
        local sk = esp.Skeleton
        
        drawBone(sk.Head, bones.Head, bones.UpperTorso)
        drawBone(sk.Neck, bones.UpperTorso, bones.LowerTorso)
        drawBone(sk.UpperSpine, bones.UpperTorso, bones.LeftUpperArm)
        drawBone(sk.LeftShoulder, bones.LeftUpperArm, bones.LeftLowerArm)
        drawBone(sk.LeftUpperArm, bones.LeftLowerArm, bones.LeftHand)
        drawBone(sk.RightShoulder, bones.UpperTorso, bones.RightUpperArm)
        drawBone(sk.RightUpperArm, bones.RightUpperArm, bones.RightLowerArm)
        drawBone(sk.RightLowerArm, bones.RightLowerArm, bones.RightHand)
        drawBone(sk.LeftHip, bones.LowerTorso, bones.LeftUpperLeg)
        drawBone(sk.LeftUpperLeg, bones.LeftUpperLeg, bones.LeftLowerLeg)
        drawBone(sk.LeftLowerLeg, bones.LeftLowerLeg, bones.LeftFoot)
        drawBone(sk.RightHip, bones.LowerTorso, bones.RightUpperLeg)
        drawBone(sk.RightUpperLeg, bones.RightUpperLeg, bones.RightLowerLeg)
        drawBone(sk.RightLowerLeg, bones.RightLowerLeg, bones.RightFoot)
    else
        for _, line in pairs(esp.Skeleton) do
            line.Visible = false
        end
    end
    
    local isTarget = false
    if currentTarget and currentTarget.Parent and currentTarget.Parent == char then
        isTarget = true
    end
    
    if espSettings.TracerTargetEnabled and isTarget then
        esp.Tracer.From = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y)
        esp.Tracer.To = Vector2.new(pos.X, pos.Y)
        esp.Tracer.Color = Color3.fromRGB(255, 182, 255)
        esp.Tracer.Visible = true
    else
        esp.Tracer.Visible = false
    end
    
    if espSettings.HealthBarEnabled then
        local health = hum.Health
        local maxHealth = hum.MaxHealth
        local healthPercent = health / maxHealth
        
        local size = char:GetExtentsSize()
        local top = camera:WorldToViewportPoint((hrp.CFrame * CFrame.new(0, size.Y/2, 0)).Position)
        local bottom = camera:WorldToViewportPoint((hrp.CFrame * CFrame.new(0, -size.Y/2, 0)).Position)
        
        local screenSize = bottom.Y - top.Y
        local boxWidth = screenSize * 0.65
        local boxPos = Vector2.new(top.X - boxWidth/2, top.Y)
        
        local barHeight = screenSize * 0.8
        local barWidth = 3
        
        esp.HealthBar.Outline.Size = Vector2.new(barWidth, barHeight)
        esp.HealthBar.Outline.Position = Vector2.new(boxPos.X - barWidth - 2, boxPos.Y + (screenSize - barHeight)/2)
        esp.HealthBar.Outline.Visible = true
        
        esp.HealthBar.Fill.Size = Vector2.new(barWidth - 1, barHeight * healthPercent)
        esp.HealthBar.Fill.Position = Vector2.new(boxPos.X - barWidth - 1.5, boxPos.Y + (screenSize - barHeight)/2 + barHeight * (1-healthPercent))
        esp.HealthBar.Fill.Color = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
        esp.HealthBar.Fill.Visible = true
    else
        esp.HealthBar.Outline.Visible = false
        esp.HealthBar.Fill.Visible = false
    end
    
    if espSettings.NamesEnabled and getgenv().SilentAimSettings.ESPNamesEnabled then
        esp.NameTag.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
        esp.NameTag.Position = Vector2.new(pos.X, pos.Y - 40)
        esp.NameTag.Color = teamColor
        esp.NameTag.Visible = true
    else
        esp.NameTag.Visible = false
    end
end

function refreshPrecisionESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            if not espDrawings[plr] then
                createESP(plr)
            end
            updateESP(plr)
        end
    end
end

function hideAllPrecisionESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        hideESP(plr)
    end
end

Players.PlayerRemoving:Connect(function(plr)
    removeESP(plr)
end)

for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= player then
        createESP(plr)
    end
end

RunService.RenderStepped:Connect(function()
    if getgenv().SilentAimSettings.ESPEnabled then
        refreshPrecisionESP()
    else
        hideAllPrecisionESP()
    end
end)

local targetHighlight = nil

RunService.RenderStepped:Connect(function()
    local newTargetChar = nil
    
    if getgenv().SilentAimSettings.ESPEnabled and getgenv().SilentAimSettings.Enabled and currentTarget and currentTarget.Parent then
        newTargetChar = currentTarget.Parent
    end
    
    if targetHighlight and targetHighlight ~= newTargetChar then
        if targetHighlight then
            local oldHighlight = targetHighlight:FindFirstChild("ESPTargetHighlight")
            if oldHighlight then oldHighlight:Destroy() end
        end
        targetHighlight = newTargetChar
    end
    
    if targetHighlight and targetHighlight:IsA("Model") then
        local highlight = targetHighlight:FindFirstChild("ESPTargetHighlight")
        if not highlight then
            highlight = Instance.new("Highlight", targetHighlight)
            highlight.Name = "ESPTargetHighlight"
        end
        highlight.FillColor = Color3.fromRGB(255, 182, 255)
        highlight.OutlineColor = Color3.fromRGB(255, 182, 255)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Enabled = true
    end
end)